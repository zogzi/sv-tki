DISCORD_TOKEN=
GUILD_ID=
DEFAULT_CHANNEL_ID=
DATABASE_PATH=runtime/svetki.sqlite
AI_ENABLED=false
# Separate API credentials; a ChatGPT/Codex subscription is not used by the bot.
# Any provider implementing the OpenAI-style /chat/completions API may be configured.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Legacy alias remains supported for existing installations.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_REQUEST_CAP=2
# USD reservation per request; must conservatively exceed actual provider cost.
AI_REQUEST_BUDGET_USD=0.01
AI_DAILY_BUDGET_USD=0.02
